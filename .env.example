# Copiar a .env.local (ignorado por git). Pedir los valores al líder del proyecto.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Modo demo: si es "true", la app usa src/mocks en lugar de Supabase.
# Útil para trabajar sin conexión o antes de tener credenciales.
VITE_USE_MOCKS=true
